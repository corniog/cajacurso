# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/cajacurso

# Clave larga y aleatoria (mínimo 32 caracteres) para firmar sesiones y cifrar credenciales
AUTH_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio-de-32-o-mas

# URL pública de la plataforma (la usan los enlaces, correos, APK y Windows)
APP_URL=http://localhost:3000

# Carpeta donde se guardan las fotos de boletas
UPLOAD_DIR=./uploads

# Correo (Plan Pro: avisos y recordatorios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CajaCurso <no-responder@tudominio.cl>"

# Mercado Pago de la plataforma (cobro del Plan Pro)
MP_PLATFORM_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Google Drive (Plan Pro: respaldo de boletas)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protege la ruta de recordatorios automáticos (cron)
CRON_SECRET=

# Enlaces de descarga de las apps (página /descargas). Déjalos vacíos hasta publicar los archivos
APK_URL=
WINDOWS_URL=

# Solo para docker compose
DB_PASSWORD=cambia-esta-clave

# ---- Para publicar en Vercel + Supabase ----
# Cadena de conexión de Supabase (Connect → Transaction pooler, puerto 6543). Reemplaza DATABASE_URL de arriba
# Almacenamiento de boletas en Supabase (Project Settings → API / API Keys)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=boletas

# Administradores (correos separados por coma): ven el panel /admin y pueden activar planes a mano
ADMIN_EMAILS=

# Datos para pagos por transferencia (se muestran al tesorero). Usa \n para separar líneas
TRANSFER_INFO=
