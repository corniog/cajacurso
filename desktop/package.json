{
  "name": "cajacurso-desktop",
  "version": "1.0.0",
  "description": "CajaCurso para Windows",
  "main": "main.js",
  "author": "CajaCurso",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cl.cajacurso.app",
    "productName": "CajaCurso",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "config.json", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "perMachine": false },
    "artifactName": "CajaCurso-Setup-${version}.${ext}"
  }
}
